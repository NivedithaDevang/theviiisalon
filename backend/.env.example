PORT=4000
NODE_ENV=production

DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=theviiisalon

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=salon@example.com
ADMIN_DEFAULT_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SECRET_KEY=replace-with-a-long-random-secret

# Public frontend origin(s), comma-separated if needed.
REACT_URL=https://your-frontend-domain.example

# Gmail SMTP example; use an app password, not your Gmail account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-salon-email@gmail.com
SMTP_PASS=your-gmail-app-password
ADMIN_NOTIFY_EMAIL=salon@example.com
