{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theviiisalon-backend",
  "main": "server.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ADMIN_EMAIL": "theviiisalon88@gmail.com",
    "ADMIN_NOTIFY_EMAIL": "theviiisalon88@gmail.com",
    "DB_HOST": "localhost",
    "DB_NAME": "theviiisalon",
    "DB_PASSWORD": "root",
    "DB_USER": "root",
    "DB_PORT": "3306",
    "DP_PORT": "3306",
    "NODE_ENV": "production",
    "REACT_URL": "https://theviiisalon.niveditha8277.workers.dev",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true",
    "SMTP_USER": "theviiisalon88@gmail.com"
  }
}
